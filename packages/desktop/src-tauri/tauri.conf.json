{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "piko",
    "version": "0.1.0",
    "identifier": "com.piko.desktop",
    "build": {
        "devUrl": "http://localhost:4100",
        "frontendDist": "../../app/.output/public",
        "beforeDevCommand": {
            "script": "bun nx run-many -t dev -p @piko/app,@piko/daemon --outputStyle=stream",
            "cwd": "../../..",
            "wait": false
        },
        "beforeBuildCommand": {
            "script": "bun nx run @piko/daemon:fetch-lima && bun nx run-many -t build,sidecar -p @piko/app,@piko/daemon --outputStyle=stream",
            "cwd": "../../.."
        }
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "piko",
                "width": 1280,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:47610 asset: http://asset.localhost",
                "img-src": "'self' data: asset: http://asset.localhost blob:",
                "frame-src": "asset: http://asset.localhost blob:",
                "object-src": "asset: http://asset.localhost blob:",
                "font-src": "'self' data:"
            },
            "assetProtocol": {
                "enable": true,
                "scope": ["$HOME/Piko/**"]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "externalBin": ["binaries/piko-daemon"],
        "resources": {
            "../../daemon/plugins/": "plugins/"
        },
        "macOS": {
            "signingIdentity": "-",
            "entitlements": "Entitlements.plist"
        }
    },
    "plugins": {
        "updater": {
            "endpoints": ["https://github.com/kedrzu/piko/releases/download/development/latest.json"],
            "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY"
        }
    }
}
