{
    // Type-checks the scripts that run inside the agent's container (`piko.js`), which the daemon embeds as text
    // rather than compiling: `bun run typecheck` runs it through the daemon's `typecheck` script.
    "extends": "@nzyme/tsconfig/esm.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "composite": false,
        "incremental": false,
        "types": ["bun"]
    },
    "include": ["*.js"]
}
