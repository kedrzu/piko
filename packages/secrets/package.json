{
    "name": "@poweragents/secrets",
    "version": "0.0.0",
    "private": true,
    "description": "The repo's secret declarations, its Bitwarden store and the loader that installs the secrets into the container's config",
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./package.json": "./package.json",
        "./*.js": {
            "types": "./dist/*.d.ts",
            "source": "./src/*.ts",
            "import": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "dependencies": {
        "@nzyme/bitwarden": "workspace:*",
        "@nzyme/config": "workspace:*",
        "@nzyme/ioc": "workspace:*",
        "@nzyme/secrets": "workspace:*"
    },
    "devDependencies": {
        "@nzyme/ioc-testing": "workspace:*",
        "@nzyme/tsconfig": "workspace:*"
    }
}
